{
  "components": {
    "schemas": {
      "AnnotationRequest": {
        "properties": {
          "height": {
            "exclusiveMinimum": 0.0,
            "maximum": 768.0,
            "title": "Height",
            "type": "integer"
          },
          "screenshot": {
            "minLength": 1,
            "title": "Screenshot",
            "type": "string"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "maximum": 1024.0,
            "title": "Width",
            "type": "integer"
          },
          "x": {
            "maximum": 1024.0,
            "minimum": 0.0,
            "title": "X",
            "type": "integer"
          },
          "y": {
            "maximum": 768.0,
            "minimum": 0.0,
            "title": "Y",
            "type": "integer"
          }
        },
        "required": [
          "screenshot",
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "AnnotationRequest",
        "type": "object"
      },
      "CreateRunRequest": {
        "properties": {
          "task": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Task",
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "title": "CreateRunRequest",
        "type": "object"
      },
      "FailureRequest": {
        "properties": {
          "failure_type": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Failure Type",
            "type": "string"
          },
          "rationale": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rationale"
          }
        },
        "required": [
          "failure_type"
        ],
        "title": "FailureRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ManualEditRequest": {
        "properties": {
          "instructions": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Instructions",
            "type": "array"
          },
          "rationale": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rationale"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/ManualStepRequest"
            },
            "maxItems": 20,
            "title": "Steps",
            "type": "array"
          }
        },
        "title": "ManualEditRequest",
        "type": "object"
      },
      "ManualStepRequest": {
        "properties": {
          "actions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "maxItems": 20,
            "title": "Actions",
            "type": "array"
          },
          "instruction": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Instruction",
            "type": "string"
          },
          "ui_summary": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ui Summary"
          }
        },
        "required": [
          "instruction"
        ],
        "title": "ManualStepRequest",
        "type": "object"
      },
      "ReplanRequest": {
        "properties": {
          "annotation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnnotationRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "failure_type": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Type"
          },
          "guidance": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guidance"
          },
          "rationale": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rationale"
          }
        },
        "title": "ReplanRequest",
        "type": "object"
      },
      "ResumeRunRequest": {
        "properties": {
          "guidance": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guidance"
          },
          "handled_outside": {
            "default": false,
            "title": "Handled Outside",
            "type": "boolean"
          }
        },
        "title": "ResumeRunRequest",
        "type": "object"
      },
      "StatusRequest": {
        "properties": {
          "reason": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "pattern": "^(running|paused|failed)$",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "StatusRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
