# Planner service
PLOVER_PLANNER_HOST=127.0.0.1
PLOVER_PLANNER_PORT=8000
# Set to 1 when you want uvicorn reload in local backend work.
PLOVER_PLANNER_RELOAD=0

# Executor service
# Use mock for a safe local prototype, or switch to macos after granting
# Accessibility and Screen Recording permissions to the terminal or Executor.
PLOVER_EXECUTOR_DRIVER=mock
PLOVER_EXECUTOR_BIND=127.0.0.1
PLOVER_EXECUTOR_PORT=50051

# Persistence
# PLOVER_DATABASE_PATH=./data/plover.sqlite3
# PLOVER_DATABASE_URL=postgresql://plover:secret@127.0.0.1:5432/plover

# Docker Compose stack
PLOVER_POSTGRES_DB=plover
PLOVER_POSTGRES_USER=plover
PLOVER_POSTGRES_PASSWORD=plover
PLOVER_FRONTEND_PUBLISH_PORT=3000
PLOVER_PLANNER_PUBLISH_PORT=8000

# Docker + host macOS Executor
# PLOVER_EXECUTOR_DRIVER=macos
# PLOVER_EXECUTOR_TARGET=host.docker.internal:50051

# Live View
# PLOVER_VNC_TARGET=127.0.0.1:5900
# PLOVER_OBSERVATION_PATH=/absolute/path/to/frame-{run_id}.png
# PLOVER_OBSERVATION_URL=http://127.0.0.1:9001/frame/{run_id}.png
# PLOVER_OBSERVATION_HEADERS={"authorization":"Bearer demo-token"}

# Vision model
# PLOVER_LLM_ENDPOINT=http://127.0.0.1:9000/v1/chat/completions
# PLOVER_LLM_MODEL=computer-use
# PLOVER_LLM_API_KEY=
# PLOVER_LLM_API_KEY_HEADER=Authorization
# PLOVER_LLM_API_KEY_PREFIX='Bearer '
# PLOVER_LLM_EXTRA_HEADERS='{"x-deployment":"staging"}'
# PLOVER_LLM_STREAM=1
# PLOVER_LLM_BOOTSTRAP_ENDPOINT=http://127.0.0.1:9000/session
# PLOVER_LLM_BOOTSTRAP_METHOD=POST
# PLOVER_LLM_BOOTSTRAP_HEADERS='{"x-bootstrap":"true"}'
# PLOVER_LLM_BOOTSTRAP_BODY='{"grant_type":"client_credentials"}'
# PLOVER_LLM_BOOTSTRAP_TOKEN_PATH=session.access_token
# PLOVER_LLM_BOOTSTRAP_EXPIRES_IN_PATH=session.expires_in
# PLOVER_LLM_BOOTSTRAP_HEADER_NAME=Authorization
# PLOVER_LLM_BOOTSTRAP_HEADER_PREFIX='Bearer '
# PLOVER_LLM_BOOTSTRAP_FLOW='[{"endpoint":"http://127.0.0.1:9000/session","capture":{"ticket":"stage.ticket"}},{"endpoint":"http://127.0.0.1:9000/exchange","method":"POST","headers":{"x-ticket":"${ticket}"},"body":"{\"ticket\":\"${ticket}\"}"}]'

# Dev launcher
PLOVER_FRONTEND_HOST=127.0.0.1
PLOVER_FRONTEND_PORT=5173
PLOVER_START_EXECUTOR=1
PLOVER_START_FRONTEND=1
